l','victory','victoryTime','victoryRupees','victoryHearts','continueButton','startButton','saveButton','joystick','joystickKnob'].map(id=>[id,$(id)]));\nconst W=72,H=72,TW=64,TH=32,clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);\nconst rand=n=>{const x=Math.sin(n*127.1+311.7)*43758.5453;return x-Math.floor(x)};\nconst state={started:false,paused:false,dialog:false,won:false,x:35.5,y:38.5,face:{x:0,y:1},hp:6,maxHp:6,rupees:0,stamina:100,stones:0,quest:0,kills:0,time:0,attack:0,dash:0,invuln:0,area:'Mossbell Village',interact:null,elapsed:0};\nlet map=[],decor=[],enemies=[],particles=[],toastTimer=0,areaTimer=0,last=0,damageFlash=0;\nconst keys=new Set(),stick={x:0,y:0,pointer:null};\nconst elder={x:36.4,y:38.2,name:'Elder Maelin',kind:'elder',label:'Speak'};\nconst stones=[{x:18.5,y:15.5,name:'Dawn Wardstone',kind:'stone',label:'Awaken',color:'#f5d477'},{x:54.5,y:17.5,name:'Tide Wardstone',kind:'stone',label:'Awaken',color:'#78d6cd'},{x:19.5,y:55.5,name:'Root Wardstone',kind:'stone',label:'Awaken',color:'#bbdf8a'}];\nconst boss={x:54.5,y:55.5,hp:12,maxHp:12,active:false,attack:0};\nconst npcs=[elder,{x:34,y:35.3,name:'Pip the Merchant',kind:'merchant',label:'Talk'},{x:40.2,y:40.3,name:'Lina the Gardener',kind:'villager',label:'Talk'}];\nfunction generateWorld(){\n map=Array.from({length:H},(_,y)=>Array.from({length:W},(_,x)=>{\n  const n=rand(x*91+y*173),ridge=Math.sin(x*.19+y*.11)+Math.cos(y*.17-x*.13);\n  if(x<2||y<2||x>W-3||y>H-3)return 'water';\n  if((x-47)**2/23+(y-34)**2/12<1.1||Math.abs(x-(8+Math.sin(y*.17)*2))<1.2&&y>9&&y<40)return 'water';\n  if(x>=31&&x<=41&&y>=33&&y<=43)return 'village';\n  if((x-36)**2+(y-38)**2<190)return 'meadow';\n  if((x-54)**2+(y-55)**2<100)return 'ruins';\n  if(n>.78&&ridge>.25)return 'grove';\n  if(n>.52&&ridge>.1)return 'forest';\n  return 'meadow';\n }));\n // Winding golden trails connect the village to all three shrines and the old sanctum.\n const paths=[[36,38,18,16],[36,38,55,18],[36,39,20,55],[36,40,55,55]];\n for(const [sx,sy,ex,ey] of paths){const steps=Math.max(Math.abs(ex-sx),Math.abs(ey-sy))*2;for(let i=0;i<=steps;i++){const t=i/steps,x=Math.round(sx+(ex-sx)*t+Math.sin(t*7)*1.1),y=Math.round(sy+(ey-sy)*t+Math.cos(t*9)*.8);if(map[y]?.[x]&&map[y][x]!=='water'){map[y][x]='path';if(map[y+1]?.[x]&&map[y+1][x]!=='water'&&rand(i+sx)>.62)map[y+1][x]='path'}}}\n // Village green and clustered cottages.\n for(let y=34;y<42;y++)for(let x=32;x<41;x++)if(map[y][x]!=='water')map[y][x]='village';\n decor=[];\n for(let y=3;y<H-3;y++)for(let x=3;x<W-3;x++){\n  const tile=map[y][x],r=rand(x*13+y*71+4);\n  if(tile==='village'&&r>.91&&!(x>34&&x<39&&y>36&&y<40))decor.push({x:x+.5,y:y+.5,type:'house',seed:r});\n  else if((tile==='forest'||tile==='grove')&&r>.55)decor.push({x:x+.5,y:y+.5,type:r>.91?'pine':'tree',seed:r});\n  else if((tile==='meadow'||tile==='path')&&r>.986)decor.push({x:x+.5,y:y+.5,type:'flower',seed:r});\n  else if(tile==='ruins'&&r>.91)decor.push({x:x+.5,y:y+.5,type:'pillar',seed:r});\n }\n enemies=[{x:26.5,y:24.5,hp:3,maxHp:3,cool:0,hit:0,type:'slime',seed:1},{x:47.5,y:28.5,hp:3,maxHp:3,cool:.6,hit:0,type:'slime',seed:2},{x:27.5,y:49.5,hp:3,maxHp:3,cool:.3,hit:0,type:'moss',seed:3},{x:47.5,y:47.5,hp:3,maxHp:3,cool:1,hit:0,type:'moss',seed:4},{x:57,y:51,hp:4,maxHp:4,cool:1,hit:0,type:'slime',seed:5}];\n}\nfunction resize(){const dpr=Math.min(devicePixelRatio||1,2),w=innerWidth,h=innerHeight;canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);canvas.style.width=w+'px';canvas.style.height=h+'px';ctx.setTransform(dpr,0,0,dpr,0,0)}\naddEventListener('resize',resize);resize();generateWorld();\nfunction project(x,y){return {x:(x-y)*TW/2,y:(x+y)*TH/2}}\nfunction screenPoint(x,y){const p=project(x-state.x,y-state.y);return {x:innerWidth/2+p.x,y:innerHeight/2+p.y}}\nfunction tileColor(t,x,y){const n=rand(x*33+y*19);if(t==='water')return n>.6?'#397a72':'#34746c';if(t==='path')return n>.5?'#b8a675':'#af9e6d';if(t==='village')return n>.5?'#719163':'#68885c';if(t==='forest')return n>.5?'#416b49':'#3c6645';if(t==='grove')return n>.5?'#365f41':'#3c6846';if(t==='ruins')return n>.5?'#777f67':'#717a62';return n>.5?'#568052':'#527b4e'}\nfunction diamond(x,y,color){ctx.fillStyle=color;ctx.beginPath();ctx.moveTo(x,y-TH/2);ctx.lineTo(x+TW/2,y);ctx.lineTo(x,y+TH/2);ctx.lineTo(x-TW/2,y);ctx.closePath();ctx.fill()}\nfunction drawTile(x,y){const p=screenPoint(x+.5,y+.5);diamond(p.x,p.y,tileColor(map[y][x],x,y));if(map[y][x]==='water'){ctx.strokeStyle='rgba(164,224,202,.13)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(p.x-12,p.y+Math.sin(state.elapsed*1.7+x)*3);ctx.lineTo(p.x+8,p.y+Math.sin(state.elapsed*1.7+x+1)*3);ctx.stroke()}}\nfunction drawTree(o){const p=screenPoint(o.x,o.y),s=o.type==='pine'?1.1:.88;ctx.fillStyle='rgba(19,39,27,.24)';ctx.beginPath();ctx.ellipse(p.x,p.y+5,20*s,8*s,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#755b3e';ctx.fillRect(p.x-3,p.y-22*s,6,24*s);const colors=o.type==='pine'?['#285542','#326b4c','#3e8054']:['#2e5e3e','#39734a','#4a8750'];for(let i=0;i<3;i++){ctx.fillStyle=colors[i];ctx.beginPath();ctx.ellipse(p.x+(i-1)*7*s,p.y-28*s-i*7*s,16*s-i*2,13*s,0,0,Math.PI*2);ctx.fill()}ctx.fillStyle='rgba(217,231,163,.16)';ctx.beginPath();ctx.ellipse(p.x-5,p.y-43*s,6,3,0,0,Math.PI*2);ctx.fill()}\nfunction drawHouse(o){const p=screenPoint(o.x,o.y),w=34,h=24;ctx.fillStyle='rgba(22,39,27,.24)';ctx.beginPath();ctx.ellipse(p.x,p.y+8,26,10,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#9b7955';ctx.fillRect(p.x-w/2,p.y-h,w,h);ctx.fillStyle='#d2bc87';ctx.fillRect(p.x-w/2+3,p.y-h+3,w-6,h-3);ctx.fillStyle='#694b3b';ctx.beginPath();ctx.moveTo(p.x-w/2-5,p.y-h+4);ctx.lineTo(p.x,p.y-h-13);ctx.lineTo(p.x+w/2+5,p.y-h+4);ctx.closePath();ctx.fill();ctx.fillStyle='#584231';ctx.fillRect(p.x-4,p.y-12,9,12);ctx.fillStyle='#9ac5b0';ctx.fillRect(p.x-13,p.y-17,6,6);ctx.fillRect(p.x+8,p.y-17,6,6)}\nfunction drawStone(o,i){const p=screenPoint(o.x,o.y);ctx.fillStyle='rgba(22,30,27,.3)';ctx.beginPath();ctx.ellipse(p.x,p.y+7,22,9,0,0,Math.PI*2);ctx.fill();if(state.stones&(1<<i)){ctx.fillStyle=o.color+'aa';ctx.beginPath();ctx.arc(p.x,p.y-22,27+Math.sin(state.elapsed*2)*2,0,Math.PI*2);ctx.fill()}ctx.fillStyle='#6c7666';ctx.beginPath();ctx.moveTo(p.x-15,p.y+2);ctx.lineTo(p.x-10,p.y-25);ctx.lineTo(p.x-2,p.y-37);ctx.lineTo(p.x+13,p.y-30);ctx.lineTo(p.x+17,p.y+2);ctx.closePath();ctx.fill();ctx.fillStyle=o.color;ctx.globalAlpha=.6+Math.sin(state.elapsed*3+i)*.18;ctx.beginPath();ctx.moveTo(p.x-6,p.y-24);ctx.lineTo(p.x-1,p.y-34);ctx.lineTo(p.x+7,p.y-27);ctx.lineTo(p.x+4,p.y-12);ctx.closePath();ctx.fill();ctx.globalAlpha=1}\nfunction drawActor(o,type){const p=screenPoint(o.x,o.y);ctx.fillStyle='rgba(11,28,21,.28)';ctx.beginPath();ctx.ellipse(p.x,p.y+4,11,5,0,0,Math.PI*2);ctx.fill();if(type==='player'){const blink=state.invuln>0&&Math.floor(state.elapsed*16)%2===0;if(blink)return;ctx.fillStyle='#293d39';ctx.fillRect(p.x-6,p.y-16,12,16);ctx.fillStyle='#e7c89b';ctx.beginPath();ctx.arc(p.x,p.y-20,6.5,0,Math.PI*2);ctx.fill();ctx.fillStyle='#426c53';ctx.beginPath();ctx.moveTo(p.x-7,p.y-24);ctx.lineTo(p.x+2,p.y-31);ctx.lineTo(p.x+7,p.y-23);ctx.closePath();ctx.fill();ctx.fillStyle='#e9cf79';ctx.fillRect(p.x-3,p.y-12,6,2);if(state.attack>0){ctx.strokeStyle='#f7e4a5';ctx.lineWidth=3;ctx.beginPath();ctx.arc(p.x+state.face.x*12,p.y-17+state.face.y*5,18,-1.2,1.2);ctx.stroke()}}else if(type==='enemy'){const col=o.type==='moss'?'#6c935b':'#8cbf74';ctx.fillStyle=o.hit>0?'#fff0c1':col;ctx.beginPath();ctx.ellipse(p.x,p.y-9,11,10+Math.sin(state.elapsed*4+o.seed)*1.5,0,Math.PI,0);ctx.lineTo(p.x+11,p.y);ctx.lineTo(p.x-11,p.y);ctx.fill();ctx.fillStyle='#203c31';ctx.fillRect(p.x-5,p.y-12,2,2);ctx.fillRect(p.x+4,p.y-12,2,2)}else{ctx.fillStyle=type==='boss'?'#49313b':o.kind==='elder'?'#d2b776':'#cb855f';ctx.beginPath();ctx.arc(p.x,p.y-20,7,0,Math.PI*2);ctx.fill();ctx.fillStyle=type==='boss'?'#6d3543':o.kind==='elder'?'#718e65':'#3e795f';ctx.fillRect(p.x-7,p.y-14,14,14);if(type==='boss'){ctx.fillStyle='#e87868';ctx.fillRect(p.x-6,p.y-21,3,3);