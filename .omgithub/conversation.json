;begin();saveDataOnly()}\nfunction saveDataOnly(){try{localStorage.setItem('verdant-crown-save',JSON.stringify({x:state.x,y:state.y,hp:state.hp,rupees:state.rupees,stamina:state.stamina,stones:state.stones,quest:state.quest,kills:state.kills,time:state.time,bossHp:boss.hp,bossActive:boss.active}))}catch(e){}}\nfunction save(){saveDataOnly();toast('Journey saved safely')}\nfunction load(){try{const d=JSON.parse(localStorage.getItem('verdant-crown-save')||'null');if(!d)return false;Object.assign(state,{x:d.x,y:d.y,hp:d.hp,rupees:d.rupees,stamina:d.stamina,stones:d.stones,quest:d.quest,kills:d.kills,time:d.time});boss.hp=d.bossHp??boss.maxHp;boss.active=!!d.bossActive;return true}catch(e){return false}}\nfunction collides(x,y){if(x<2.2||y<2.2||x>W-3||y>H-3)return true;const at=(a,b)=>map[Math.floor(b)]?.[Math.floor(a)]==='water';return at(x-.18,y)||at(x+.18,y)||at(x,y-.18)||at(x,y+.18)}\nfunction move(dx,dy,dt){const len=Math.hypot(dx,dy);if(len<.1)return;dx/=Math.max(1,len);dy/=Math.max(1,len);state.face={x:dx,y:dy};const speed=state.dash>0?7.4:3.65;let nx=state.x+dx*speed*dt,ny=state.y+dy*speed*dt;if(!collides(nx,state.y))state.x=nx;if(!collides(state.x,ny))state.y=ny;state.x=clamp(state.x,2.2,W-3);state.y=clamp(state.y,2.2,H-3)}\nfunction nearest(){if(!state.started)return null;let best=null,bd=2.15;for(const o of npcs){const d=dist(state,o);if(d<bd){best=o;bd=d}}for(let i=0;i<stones.length;i++){const o=stones[i],d=dist(state,o);if(d<bd&&!(state.stones&(1<<i))){best=o;bd=d}}if(state.quest>=2){const o={x:55,y:55,name:'Old Sanctum',kind:'sanctum',label:'Enter'};const d=dist(state,o);if(d<bd){best=o;bd=d}}return best}\nfunction openDialog(name,text,portrait=''){state.dialog=true;state.paused=false;ui.dialog.classList.remove('is-hidden');ui.dialogName.textContent=name;ui.dialogText.textContent=text;ui.dialogPortrait.textContent=portrait;ui.interactPrompt.classList.add('is-hidden')}\nfunction interact(){const o=state.interact||nearest();if(!o)return;if(o.kind==='elder'){if(state.quest===0){openDialog(o.name,'The valley’s wardstones have gone dim. Seek the three shrines, awaken each stone, and return life to the roots. Take this little purse; the road is long.','✦');state.quest=1;state.rupees+=12;toast('New quest: awaken the three Wardstones')}else openDialog(o.name,state.quest<2?'The Wardstones lie beyond the village: Dawnwood to the northwest, Tideglass to the northeast, and Rootbound to the south.':'The old sanctum lies beneath the southern ruins. The Hollow King waits within.','✦')}\n else if(o.kind==='merchant')openDialog(o.name,'Fresh berries for the road! They restore a heart, free of charge. The valley needs all the help it can get.','❀');else if(o.kind==='villager')openDialog(o.name,'Follow the golden paths through the trees. The stones will answer when you stand close and press Use.','❀');else if(o.kind==='stone'){const i=stones.indexOf(o);state.stones|=1<<i;state.rupees+=8;state.hp=Math.min(state.maxHp,state.hp+1);for(let n=0;n<12;n++)particles.push({x:o.x,y:o.y,life:.8+rand(n)*.4,size:2+rand(n+40)*4,color:o.color});toast(`${o.name} awakened · +8 rupees`);if(countStones()===3){state.quest=2;boss.active=false;toast('All Wardstones shine. The sanctum is open.')}saveDataOnly();openDialog(o.name,'A warm pulse rolls through the valley. The old roots remember their strength.','✧')}\n else if(o.kind==='sanctum'){state.quest=3;boss.active=true;boss.hp=Math.max(1,boss.hp);state.x=54.5;state.y=54;toast('The Hollow King stirs beneath the ruins');showArea('The Old Sanctum')}\n updateHud()}\nfunction advanceDialog(){if(!state.dialog)return;state.dialog=false;ui.dialog.classList.add('is-hidden');if(state.quest===1&&state.rupees===12){}updateHud()}\nfunction attack(){if(!state.started||state.paused||state.dialog||state.won||state.attack>0)return;state.attack=.34;let hit=false;for(const e of enemies){if(e.hp<=0||dist(state,e)>2.35)continue;const fx=e.x-state.x,fy=e.y-state.y;if(fx*state.face.x+fy*state.face.y<-.3)continue;e.hp--;e.hit=.2