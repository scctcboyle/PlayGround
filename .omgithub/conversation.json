l.mjs\n-rw-r--r-- 1 runner runner   974 Nov  7 22:46 worker-tunnel.test.mjs\nimport { existsSync, readFileSync, writeFileSync, mkdirSync, statSync } from 'node:fs'\nimport { resolve, join, extname } from 'node:path'\nimport { createHash } from 'node:crypto'\nimport { createServer } from 'node:http'\nimport { spawn } from 'node:child_process'\nimport { pathToFileURL } from 'node:url'\nimport { child } from './session-lifecycle.mjs'\nimport { livePreviewScript, watchProject } from './live-preview.mjs'\n\nexport function projectType(root) {\n  if (existsSync(join(root, 'package.json'))) {\n    const p = JSON.parse(readFileSync(join(root, 'package.json'), 'utf8'))\n    if (p.dependencies?.next || p.devDependencies?.next) throw new Error('Unsupported framework: customize start.sh and provide static deployment output.')\n    if (p.dependencies?.vite || p.devDependencies?.vite) return 'vite'\n    throw new Error('Unsupported package project: customize start.sh and deployment output.')\n  }\n  if (existsSync(join(root, 'index.html'))) return 'html'\n  throw new Error('No generated index.html or supported package project.')\n}\nexport async function start(root = process.cwd()) {\n  const type = projectType(root)\n  const projectRoot = resolve(root)\n  if (type === 'vite') {\n    const stampDir = process.env.OPENCODE_WEB_DIR || join(root, 'node_modules', '.cache')\n    mkdirSync(stampDir, { recursive: true })\n    const stamp = join(stampDir, 'default-dependencies')\n    const lock = join(root, 'package-lock.json')\n    const hash = createHash('sha256').update(readFileSync(join(root, 'package.json'))).update(existsSync(lock) ? readFileSync(lock) : '').digest('hex')\n    let old = ''\n    try { old = readFileSync(stamp, 'utf8') } catch {}\n    if (old !== hash || !existsSync(join(root, 'node_modules/vite'))) {\n      await child('npm', [existsSync(lock) ? 'ci' : 'install', '--no-audit', '--no-fund'], { cwd: root })\n      mkdirSync(stampDir, { recursive: true })\n      const installedHash = createHash('sha256').update(readFileSync(join(root, 'package.json'))).update(existsSync(lock) ? readFileSync(lock) : '').digest('hex')\n      writeFileSync(stamp, installedHash)\n    }\n    await child(process.execPath, [join(root, 'node_modules/vite/bin/vite.js'), 'build', '--base', './'], { cwd: root })\n    root = join(root, 'dist')\n  }\n  if (!existsSync(join(root, 'index.html'))) throw new Error('Static deployment output must contain index.html.')\n  if (process.env.OPENCODE_WEB_DIR) writeFileSync(join(process.env.OPENCODE_WEB_DIR, 'deployment-output.json'), JSON.stringify({ project: projectRoot, directory: resolve(root) }))\n  const mime = { '.html':'text/html', '.js':'application/javascript', '.css':'text/css', '.json':'application/json', '.svg':'image/svg+xml', '.png':'image/png', '.jpg':'image/jpeg', '.webp':'image/webp', '.wasm':'application/wasm', '.glb':'model/gltf-binary' }\n  const clients = new Set()\n  const stopWatching = watchProject(root, () => { for (const client of clients) client.write('event: change\\ndata: changed\\n\\n') })\n  const keepAlive = setInterval(() => { for (const client of clients) client.write(': keepalive\\n\\n') }, 20000)\n  const buildWatcher = type === 'vite' ? spawn(process.execPath, [join(projectRoot, 'node_modules/vite/bin/vite.js'), 'build', '--base', './', '--watch'], { cwd: projectRoot, stdio: 'inherit' }) : null\n  const server = createServer((req, res) => {\n    try {\n      const url = new URL(req.url, 'http://localhost')\n      if (url.pathname === '/__omgithub/live') {\n        res.writeHead(200, { 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-cache', 'X-Accel-Buffering': 'no', Connection: 'keep-alive' })\n        res.write(': connected\\n\\n')\n        clients.add(res)\n        req.on('close', () => clients.delete(res))\n        return\n      }\n      const path = resolve(root, '.' + decodeURIComponent(url.pathname))\n      if (path !== resolve(root) && !path.startsWith(resolve(root) + '/')) { res.writeHead(404); res.end(); return }\n      const file = statSync(path).isDirectory() ? join(path, 'index.html') : path\n      res.setHeader('Content-Type', mime[extname(file)] || 'application/octet-stream')\n      res.setHeader('Cache-Control', url.searchParams.has('omgithub_live') ? 'no-store' : 'no-cache')\n      const content = readFileSync(file)\n      if (extname(file) === '.html' && url.searchParams.get('omgithub_live') === '1') {\n        const html = content.toString()\n        res.end(/<\\/body\\s*>/i.test(html) ? html.replace(/<\\/body\\s*>/i, `${livePreviewScript}</body>`) : html + livePreviewScript)\n      } else res.end(content)\n    } catch { res.writeHead(404); res.end('Not found') }\n  })\n  server.on('close', () => { stopWatching(); clearInterval(keepAlive); buildWatcher?.kill(); for (const client of clients) client.end() })\n  server.listen(Number(process.env.PORT || 3000), '0.0.0.0')\n  return server\n}\nif (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) await start()\nimport { startForCapture } from './capture-start.mjs'\nimport captures from './wip-screenshots.cjs'\nimport { createRequire } from 'node:module'\nimport { readFileSync, mkdirSync } from 'node:fs'\nimport { join } from 'node:path'\nconst runtime = join(process.env.HOME, '.local/share/omgithub-playwright')\nconst require = createRequire(join(runtime, 'package.json'))\nconst { chromium } = require('playwright')\ncaptures.instrument({ chromium })\nconst config = JSON.parse(readFileSync(join(runtime, process.platform === 'darwin' ? 'metal.json' : 'linux.json'), 'utf8'))\nif (process.platform === 'linux') process.env.DISPLAY ||= ':' + readFileSync(join(runtime, 'display'), 'utf8').trim()\nconst url = process.env.CAPTURE_URL, output = process.env.CAPTURE_DIR\nif (!url || !output) throw new Error('Set CAPTURE_URL and CAPTURE_DIR.')\nmkdirSync(output, { recursive: true })\nconst transient = error => { throw Object.assign(error, { exitCode: 75 }) }\nlet browser\ntry {\n  browser = await chromium.launch({ ...config.browser.launchOptions, timeout: 30000 }).catch(transient)\n  for (const [name, width, height] of [['desktop', 1440, 900], ['mobile', 390, 844]]) {\n    const page = await browser.newPage({ viewport: { width, height } }).catch(transient)\n    page.setDefaultTimeout(30000)\n    const failures = []\n    page.on('pageerror', error => { console.error(error.message); failures.push(error.message) })\n    page.on('response', response => { if (response.status() >= 400 && new URL(response.url()).origin === new URL(url).origin) failures.push(`HTTP ${response.status()}: ${response.url()}`) })\n    const response = await page.goto(url, { waitUntil: 'load', timeout: 45000 }).catch(transient)\n    if (!response?.ok()) throw Object.assign(new Error(`HTTP ${response?.status()} loading preview`), { exitCode: !response || [408, 429, 500, 502, 503, 504].includes(response.status()) ? 75 : 1 })\n    await page.locator(process.env.CAPTURE_READY_SELECTOR || 'body').waitFor({ state: 'visible' })\n    await page.waitForFunction(() => document.fonts.status === 'loaded')\n    const start = await startForCapture(page, {\n      enabled: process.env.CAPTURE_AUTO_START !== 'false',\n      selector: process.env.CAPTURE_START_SELECTOR || ''\n    })\n    console.log(`Capture ${name}: auto-start ${start.clicked ? 'clicked' : start.reason}`)\n    await page.waitForTimeout(1000)\n    await page.screenshot({ path: join(output, `final-${name}.png`), timeout: 30000 }).catch(error => {\n      if (error.name === 'TimeoutError' || !browser.isConnected()) transient(error)\n      throw error\n    })\n    if (process.env.CAPTURE_STRICT === '1' && failures.length) throw new Error(`Published build failed: ${failures.join('; ')}`)\n    await page.close()\n  }\n} catch (error) { console.error(error); process.exitCode = error.exitCode || 1 }\nfinally { await browser?.close().catch(error => { console.error(error); process.exitCode ||= 75 }) }\n"}],"metadata":{"status":"completed","truncated":false,"exit":0}},"time":{"created":1794091660620,"ran":1794091660686,"completed":1794091660704}}],"snapshot":{"start":"33e6b05a7db106b7347baf1522d96acff1e56429","end":"33e6b05a7db106b7347baf1522d96acff1e56429","files":[]},"finish":"tool-calls","rawFinish":"tool_calls","cost":0,"tokens":{"input":1607,"output":146,"reasoning":12,"cache":{"read":43136,"write":0}}},{"id":"msg_1b83235b4001YLJLNXhiSuLEV9","time":{"created":1794091660729,"streamed":1794091710491,"completed":1794091710526},"type":"assistant","agent":"build","model":{"id":"oc/deepseek-v4.1-flash-free","providerID":"omdev","variant":"default"},"content":[{"type":"reasoning","text":"Need build from scratch. User requests isometric open world Zelda 2D game phone/tablet. Need complete playable. We need be ambitious but realistic. Use HTML/CSS/JS canvas likely no dependencies. Need polished visuals, responsive touch controls, open world, quests, combat, dungeon, boss, items, save. We can build a rich isometric action-adventure in Canvas 2D with procedural art, no external assets. Need test with playwright screenshots.\n\nWe have plenty time. Need plan and implement. Could use multiple files modules. Must keep performant mobile. Isometric world with tile map, hand-drawn procedural sprites, ambient particles, day/night, water, trees, etc. Open world Zelda: maybe \"The Verdant Crown\" with three regions, village, forest, ruins, lake, mountain, dungeon, boss. Quest to restore 3 shrines and defeat shadow. Controls: virtual joystick + attack, interact, dash; keyboard. Need isometric movement screen-space.\n\nWe should design compelling. Build a single-page game with canvas. Need mobile portrait/tablet responsive, safe areas. Fullscreen perhaps. Intro title overlay. Use touch joystick, action buttons. Desktop keyboard and mouse? Use WASD/arrows, Space attack, E interact, Shift dash, Q potion maybe.\n\nOpen world map larger than viewport with camera. Isometric projection: grid coordinates to screen with iso. Could render in screen coords by projection for tiles. Character movement in world coordinates x,y with isometric conversion. Use a top-down logical world with x/y, draw projected. Collision with world props. Need map generation deterministic.\n\nVisual style: lush painterly pixel-ish? Canvas vector drawing with gradients, shadows, organic details. Isometric tiles with diamond shape and cliff sides. Need high quality. We'll use 2D canvas at devicePixelRatio capped 2. Use 2D shapes and procedural textures cached to offscreen canvases.\n\nCould implement:\n- World ~80x80 tiles. Elevation 0-3. tile types grass, path, water, sand, stone, forest floor, flowers, farm. elevation for hills/cliffs.\n- isometric projection: sx=(x-y)*TILE_W/2; sy=(x+y)*TILE_H/2 - z*heightStep.\n- Draw map tiles sorted by x+y. Draw tile top diamonds with textured details and edges; cliffs sides at lower neighbors.\n- Camera follows player with smoothing. Player drawn at world pos; sorting: draw map then entities sorted by depth (x+y). Trees drawn with canopy, shadows, etc. Need proper occlusion. Tile height sorting approximate.\n- Lighting: day/night tint, lantern glows, water shimmer.\n- World objects: trees, rocks, bushes, ruins, houses, shrine, chest, sign, flowers, fireflies, etc.\n- Enemies: slimes, bokoblins? Original creatures: \"Mosslings\", \"Bramble Hounds\", \"Stone Sentinels\", boss \"Hollow King\".\n- Combat: sword arc, hit enemies, knockback, hearts, rupees. Bow unlock? Maybe keep sword + dash + spin.\n- Quest: Awaken three wardstones (forest, lake, highlands), then open Sunken Sanctum in center and defeat boss. NPC elder guides. Maybe a main quest with map markers.\n- NPC dialogue: elder, merchant, fisher, child. Shop? Could implement hearts and stamina upgrades via shrines. Maybe shrines are mini puzzle/interaction where you light beacon and get max heart.\n- Collectibles: heart pieces? Simpler: 3 shrine orbs raise max hearts. Rupees.\n- Save localStorage.\n- Minimap.\n- Title screen with start, how to play.\n- Audio: WebAudio procedural ambient/music/SFX. Must start after gesture. Create simple chiptune/ambient pads and sfx.\n- Performance: mobile. Use dynamic resolution? Draw at capped 2x. Cache tiles? Maybe okay at 80x80 with culling. Render visible tiles. Should be around 300-600 tiles. Each tile drawn with paths and details; could be heavy. We can pre-render ground into offscreen canvas huge? World 80x80 tile diamonds with tile 96x48 => world 3840x3840, offscreen 4k may be memory ~59 MB, okay but mobile maybe. Better draw visible tiles each frame with cached texture patterns. Could pre-render chunks. Simpler: tile visuals drawn each frame but moderate details. 500 tiles * 5 paths = 2500 draw calls at 60fps may be okay-ish. But phones? We can use chunk caches: each 8x8 chunk rendered to offscreen with isometric tiles + static props. Then draw chunks sorted? Depth issue across chunks. Better draw map tiles into one offscreen static canvas at init for entire map? 3840x4000 maybe. Too much. Could limit world to 60x60 with tile 96 = 2880, canvas 3072x3072 ~38MB. Acceptable maybe mobile borderline. Use tile 72x36 world 64 => 2304x2304. Then whole map render into offscreen static and draw camera crop. Entities sort relative to props tricky; can draw static base then entities, props that should occlude handled separately.\n\nAlternative chunk-based dynamic. Let's do world 64x64, tile width 92, height 46. Offscreen map ground layer only at 64*92 = 5888 x 5888 if full diamond bounding - too big. Hmm iso canvas dimensions width=(W+H)*TW/2=5888. Too big.\n\nUse visible tile drawing with culling. Fine.\n\nNeed ensure 60fps. We'll build with requestAnimationFrame and cap DPR 2. Use simple paths and gradients cached per tile type? Gradient creation per tile is costly. Create small tile texture canvases for top surfaces (e.g. 92x46) with noise/detail; drawImage per tile. But tile variation and texture. We can generate e.g. 4 variants per type at 92x46, draw scaled. For elevation, top surfaces. Also edges/cliff sides. We can pre-render diamond tile variants. Then map drawing = drawImage per tile plus decorations. Good.\n\nIso mapping. Need clipping? Pre-rendered diamond exactly. Top tile draw at screen pos. Draw cliff sides beneath tile before top. Sort tiles by x+y, then elevation.\n\nLet's define world coordinates tile grid x,y. World position continuous. iso projection:\nscreenX = (x - y) * TW/2\nscreenY = (x + y) * TH/2 - z * ELEV\nwhere TW=96, TH=48, ELEV=20.\n\nCamera centered on player iso pos plus offset y maybe -30.\n\nDrawing tiles sorted by (x+y), tie by x? Ground. For each tile:\n- get h elevation (0..4). Draw top at sy - h*ELEV.\n- cliffs sides toward x+1 / y+1? In iso, south/east sides visible. For neighbor lower height, draw left/right side diamonds? We can draw a vertical prism side. Simplest: draw dark diamond offset down by ELEV*diff as \"skirt\" with gradient, then top. If only draw full diamond at base and at top? For h>0, draw side wall polygons for south edges where neighbor lower. Need coordinates:\ntop diamond corners: N=(sx, sy - TH/2), E=(sx+TW/2, sy), S=(sx, sy+TH/2), W=(sx-TW/2, sy) after elevation offset.\nVisible sides are SW and SE edges? In screen, front lower edges are W->S and S->E. If neighbor x+1 is lower, that side maybe S-E? Let's think. Direction +x in screen = right-down (east). +y = left-down. The tile front-right edge corresponds +x? Neighbor at x+1 appears right-down, tile's edge S-E. Front-left edge neighbor y+1 appears left-down, tile's edge W-S. Draw wall from those edges down by diff*ELEV. Do so.\n\n- For water, animated overlay? We'll draw base water tiles with pre-render, add animated highlights by drawing lines for visible water tiles. Could be many. Limit random shimmer points.\n\nEntities sorted by x+y plus height. Trees: base on tile; draw trunk/canopy scaled. Need draw entities and static props together. We'll generate props array with world coords and type, plus draw. For each frame, collect visible props and enemies and player, sort by depth (x+y). Tiles already drawn, then entities. But tall trees behind player should be drawn before player if their base depth less; sort handles. Trees in front drawn after. Good.\n\nProps anchored on tile top.\n\nCollision: props with circular radius. Map water blocks, cliffs transitions maybe? Need walkable logic. World coordinates, tile = floor. If target tile water or elevation > current + maybe blocked; allow climbing if height difference <= 1? Simpler all land walkable, water blocked, cliff wall collisions. Need approach to highlands. Could allow slopes/paths. We'll create map with regions and paths and no steep obstacles except water and props; elevation mostly visual. To avoid weird, collision only water, props, buildings, boundary. Movement in world XY with screen-aligned joystick direction mapping. Input joystick vector (sx, sy) maps to world dx = sx/TW? Standard iso inverse:\nworldX += (screenX / (TW/2) + screenY / (TH/2)) /2? Let's derive: iso sx=(x-y)*TW/2; sy=(x+y)*TH/2. x = sx/TW + sy/TH; y = sy/TH - sx/TW. For screen direction normalized (vx,vy), world vector = (vx*TW? no): dx = vx/(TW/2)*? Actually unit screen movement at speed s: world dx = (vx * 2/TW + vy*2/TH) * speed? This distorts; better normalize world direction from joystick mapping. Use x = vx*(1/TW)+vy*(1/TH), y = vy*(1/TH)-vx*(1/TW), then normalize * speed. This makes screen movement direction exactly. But TW=96 TH=48 yields mapping. Fine.\n\nFor keyboard, W/up moves screen up: world dx=-? if vx=0, vy=-1 => x=-1/TH, y=-1/TH normalized. So diagonal in world. Standard iso. Good.\n\nCharacter animation: simple stylized hero drawn with shapes, facing directions 8-way, sword slash arc. Draw at screen pos. Add bobbing, shadow, cape.\n\nIsometric sprites with layered shapes. Hero: green tunic/teal cloak, blonde hair, sword/shield. Use vector drawing. Need make it visually attractive. Draw in local screen coords. Facing direction from movement. For each direction, we can rotate body and draw arm. Simpler: body shape drawn from back/front based on facing screen y. Sword slash arc drawn.\n\nCombat: click/space/tap attack button. On attack, attackTimer 0.28, sword swing arc centered around facing screen angle. Hit enemies within range and angle. Add hit particles, screen shake, freeze frames maybe.\n\nDash: stamina wheel? Use stamina. Player speed, dash costs stamina, regen. Hearts.\n\nEnemies:\n- Mossling: small green slime, hops toward player, contact damage.\n- Bramble: spiky boar-like, charges.\n- Wisp: floats, shoots projectiles.\n- Boss: big stone guardian in sanctum, phases, summons.\nNeed spawn per region. Respawn over time. Loot rupees/hearts.\n\nQuest system:\n- NPC \"Elder Maelin\" in village. Initial dialogue says three wardstones lost: Verdant Grove (NE forest), Tideglass Shore (SW lake), Skyfall Ruins (NW highlands). Activate each stone by interacting. Then sanctum at center opens. Boss.\n- HUD quest tracker updates.\n- Shrines: each wardstone gives a heart container and maybe ability: dash upgrade? Could just max heart +1 and orb.\n- Dungeon/Sanctum at map center? Let's design map:\n64x64 world. Coordinates:\nvillage around (28,34) center-ish south.\nsanctum at (32,32) but locked? Actually open world center with ancient gate.\nForest region NE (x>42, y<25), lake SW (x<22,y>40), highlands NW (x<25,y<25), ruins.\nNeed camera spawn village.\nMap height: mostly 0; highlands height 1-3; cliffs around. Player can traverse via ramps.\nSimpler create height map with smooth plateaus and ramps near paths. Collision maybe allow if elevation delta <=1? Need ensure. We can let player walk over height differences but visually pop; no. Better implement height map and walking allowed if abs(delta)<=0.75 or if target tile is path? Then ramps. But player's world z smoothly lerps to tile elevation. If higher plateau edge and not ramp, block. Generate ramps