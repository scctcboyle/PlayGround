);\n45:   }\n46:   // Village cottages and signposts.\n47:   props.push({x:31.2,y:36.2,type:'house',scale:1.15},{x:41.3,y:36.8,type:'house',scale:1.05},{x:31.5,y:41.3,type:'house',scale:.92},{x:39,y:34.2,type:'well',scale:1},{x:37.5,y:41.6,type:'sign',scale:1});\n48:   for(let i=0;i<10;i++){\n49:     const x=9+rand(i+102)*54,y=16+rand(i+503)*44;\n50:     if(!['path','water','village'].includes(map[Math.floor(y)][Math.floor(x)]))enemies.push({x,y,hp:2,max:2,kind:i%3===0?'mossling':'wisp',cool:rand(i+81)*2,hit:0,homeX:x,homeY:y});\n51:   }\n52: }\n53: buildWorld();\n54: function resize(){dpr=Math.min(devicePixelRatio||1,2);vw=innerWidth;vh=innerHeight;canvas.width=Math.floor(vw*dpr);canvas.height=Math.floor(vh*dpr);canvas.style.width=vw+'px';canvas.style.height=vh+'px';ctx.setTransform(dpr,0,0,dpr,0,0)}\n55: addEventListener('resize',resize);resize();\n56: function project(x,y){return {x:(x-y)*TW/2,y:(x+y)*TH/2}}\n57: function screen(x,y){const p=project(x,y),c=project(state.x,state.y);return {x:vw/2+p.x-c.x,y:vh/2+p.y-c.y}}\n58: function tileColor(t,x,y){const n=rand(Math.floor(x)*101+Math.floor(y)*17);const pal={grass:['#477b52','#4b8055','#43764e','#51845a'],meadow:['#638451','#6b8956','#5e7d4d'],grove:['#3b704e','#3f7651','#386a49'],forest:['#376947','#3b7049','#356543'],village:['#60815a','#67855e','#5e7c56'],path:['#b5a477','#bcae83','#ac9d70'],ruins:['#71806a','#78866e','#6d7d67'],water:['#3f7d73','#458579','#39776d']};return pal[t][Math.floor(n*pal[t].length)]}\n59: function drawTile(x,y){const p=screen(x,y),t=map[y][x];if(p.x< -TW||p.x>vw+TW||p.y< -TH*2||p.y>vh+TH*3)return;\n60:   ctx.fillStyle=tileColor(t,x,y);ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(p.x+TW/2,p.y+TH/2);ctx.lineTo(p.x,p.y+TH);ctx.lineTo(p.x-TW/2,p.y+TH/2);ctx.closePath();ctx.fill();\n61:   if(t==='water'){ctx.strokeStyle='rgba(153,219,196,.2)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(p.x-10,p.y+16);ctx.lineTo(p.x+7,p.y+24);ctx.stroke()}\n62:   if((x*13+y*7)%7===0&&t!=='path'&&t!=='wat