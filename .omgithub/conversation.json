ect(p.x+3,p.y-21,3,3)}}}\nfunction drawWorld(){const w=innerWidth,h=innerHeight;ctx.clearRect(0,0,w,h);const bg=ctx.createLinearGradient(0,0,0,h);bg.addColorStop(0,'#2b5848');bg.addColorStop(1,'#193d32');ctx.fillStyle=bg;ctx.fillRect(0,0,w,h);\n // The world is deliberately modest in size; drawing the complete tile map keeps edges clean while camera-centering the hero.\n for(let y=0;y<H;y++)for(let x=0;x<W;x++){const p=screenPoint(x+.5,y+.5);if(p.x>-TW&&p.x<w+TW&&p.y>-TH&&p.y<h+TH)drawTile(x,y)}\n const items=[];for(const o of decor)if(Math.abs(o.x-state.x)+Math.abs(o.y-state.y)<30)items.push({o,sort:o.x+o.y,type:o.type});for(const o of stones)items.push({o,sort:o.x+o.y,type:'stone'});for(const o of npcs)items.push({o,sort:o.x+o.y,type:'npc'});for(const o of enemies)if(o.hp>0)items.push({o,sort:o.x+o.y,type:'enemy'});if(boss.active&&boss.hp>0)items.push({o:boss,sort:boss.x+boss.y,type:'boss'});items.push({o:state,sort:state.x+state.y,type:'player'});items.sort((a,b)=>a.sort-b.sort);\n for(const it of items){const o=it.o;if(it.type==='tree'||it.type==='pine')drawTree(o);else if(it.type==='house')drawHouse(o);else if(it.type==='flower'){const p=screenPoint(o.x,o.y);ctx.fillStyle=o.seed>.5?'#f0d17b':'#e9eee1';ctx.beginPath();ctx.arc(p.x,p.y,2,0,Math.PI*2);ctx.fill()}else if(it.type==='pillar'){const p=screenPoint(o.x,o.y);ctx.fillStyle='#8c9277';ctx.fillRect(p.x-7,p.y-20,14,20);ctx.fillStyle='#a5a58a';ctx.fillRect(p.x-9,p.y-23,18,4)}else if(it.type==='stone')drawStone(o,stones.indexOf(o));else drawActor(o,it.type)}\n for(const p of particles){const q=screenPoint(p.x,p.y);ctx.globalAlpha=clamp(p.life,0,1);ctx.fillStyle=p.color||'#f1d77e';ctx.beginPath();ctx.arc(q.x,q.y,p.size||3,0,Math.PI*2);ctx.fill()}ctx.globalAlpha=1;\n if(damageFlash>0){ctx.fillStyle=`rgba(190,55,48,${damageFlash*.14})`;ctx.fillRect(0,0,w,h)}if(state.started)drawMinimap();\n}\nfunction drawMinimap(){const w=mini.width,h=mini.height,cell=w/W;mctx.clearRect(0,0,w,h);mctx.fillStyle='#244b3d';mctx.fillRect(0,0,w,h);for(let y=0;y<H;y++)for(let x=0;x<W;x++){const t=map[y][x];mctx.fillStyle=t==='water'?'#3f7d73':t==='path'?'#b9a97b':t==='forest'||t==='grove'?'#315f43':t==='ruins'?'#77816c':t==='village'?'#718b5f':'#4c7850';mctx.fillRect(x*cell,y*cell,cell+.25,cell+.25)}for(let i=0;i<stones.length;i++)if(!(state.stones&(1<<i))){mctx.fillStyle='#f0d47a';mctx.beginPath();mctx.arc(stones[i].x*cell,stones[i].y*cell,3,0,Math.PI*2);mctx.fill()}if(boss.active&&boss.hp>0){mctx.fillStyle='#df7868';mctx.beginPath();mctx.arc(boss.x*cell,boss.y*cell,3,0,Math.PI*2);mctx.fill()}mctx.fillStyle='#fff4c4';mctx.strokeStyle='#244b3d';mctx.lineWidth=2;mctx.beginPath();mctx.arc(state.x*cell,state.y*cell,4,0,Math.PI*2);mctx.fill();mctx.stroke()}\nfunction questText(){if(!state.started)return 'Speak with Elder Maelin';if(state.quest===0)return 'Speak with Elder Maelin';if(state.quest===1)return `Awaken the Wardstones (${countStones()}/3)`;if(state.quest===2)return 'Enter the old sanctum';return 'Defeat the Hollow King'}\nfunction countStones(){return [0,1,2].filter(i=>state.stones&(1<<i)).length}\nfunction updateHud(){ui.hearts.innerHTML='';for(let i=0;i<state.maxHp/2;i++){const full=state.hp>=i*2+2,half=state.hp===i*2+1;ui.hearts.insertAdjacentHTML('beforeend',`<span class=\"heart ${full?'':'empty'} ${half?'half':''}\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path class=\"heart-base\" d=\"M12 21S2 14.5 2 8.3C2 3.5 8 2 12 6c4-4 10-2.5 10 2.3C22 14.5 12 21 12 21Z\"/><path class=\"heart-fill\" d=\"M12 21S2 14.5 2 8.3C2 3.5 8 2 12 6c4-4 10-2.5 10 2.3C22 14.5 12 21 12 21Z\"/></svg></span>`);if(half){const el=ui.hearts.lastElementChild;el.classList.remove('empty');el.querySelector('.heart-fill').style.clipPath='inset(0 50% 0 0)'}}ui.staminaFill.style.transform=`scaleX(${state.stamina/100})`;ui.rupeeCount.textContent=state.rupees;ui.questTitle.textContent=questText();ui.questEyebrow.textContent=state.quest===3?'THE HOLLOW KING':state.quest===2?'THE OLD SANCTUM':state.quest===1?'THE THREE 