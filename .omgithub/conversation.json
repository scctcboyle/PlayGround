stones.length;i++)if(!(state.stones&(1<<i))){mctx.fillStyle='#f0d47a';mctx.beginPath();mctx.arc(stones[i].x*cell,stones[i].y*cell,3,0,Math.PI*2);mctx.fill()}if(boss.active&&boss.hp>0){mctx.fillStyle='#df7868';mctx.beginPath();mctx.arc(boss.x*cell,boss.y*cell,3,0,Math.PI*2);mctx.fill()}mctx.fillStyle='#fff4c4';mctx.strokeStyle='#244b3d';mctx.lineWidth=2;mctx.beginPath();mctx.arc(state.x*cell,state.y*cell,4,0,Math.PI*2);mctx.fill();mctx.stroke()}\n+function questText(){if(!state.started)return 'Speak with Elder Maelin';if(state.quest===0)return 'Speak with Elder Maelin';if(state.quest===1)return `Awaken the Wardstones (${countStones()}/3)`;if(state.quest===2)return 'Enter the old sanctum';return 'Defeat the Hollow King'}\n+function countStones(){return [0,1,2].filter(i=>state.stones&(1<<i)).length}\n+function updateHud(){ui.hearts.innerHTML='';for(let i=0;i<state.maxHp/2;i++){const full=state.hp>=i*2+2,half=state.hp===i*2+1;ui.hearts.insertAdjacentHTML('beforeend',`<span class=\"heart ${full?'':'empty'} ${half?'half':''}\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path class=\"heart-base\" d=\"M12 21S2 14.5 2 8.3C2 3.5 8 2 12 6c4-4 10-2.5 10 2.3C22 14.5 12 21 12 21Z\"/><path class=\"heart-fill\" d=\"M12 21S2 14.5 2 8.3C2 3.5 8 2 12 6c4-4 10-2.5 10 2.3C22 14.5 12 21 12 21Z\"/></svg></span>`);if(half){const el=ui.hearts.lastElementChild;el.classList.remove('empty');el.querySelector('.heart-fill').style.clipPath='inset(0 50% 0 0)'}}ui.staminaFill.style.transform=`scaleX(${state.stamina/100})`;ui.rupeeCount.textContent=state.rupees;ui.questTitle.textContent=questText();ui.questEyebrow.textContent=state.quest===3?'THE HOLLOW KING':state.quest===2?'THE OLD SANCTUM':state.quest===1?'THE THREE WARDSTONES':'THE VERDANT CROWN';ui.questProgress.textContent=state.quest===1?`${countStones()} of 3 awakened`:state.quest===3?'Restore the valley':'Mossbell Valley';ui.menuLocation.textContent=areaFor(state.x,state.y);ui.menuStones.textContent=`${countStones()} / 3`;ui.menuRupees